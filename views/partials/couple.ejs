<section id="couple" class="panel panel--brown" aria-labelledby="coupleTitle">
  <div class="container reveal-group">
    <p class="eyebrow reveal">THE COUPLE</p>
    <h2 id="coupleTitle" class="heading reveal">Two Families, One Blessing</h2>
    <div class="divider reveal" aria-hidden="true"><span>&#10054;</span></div>

    <div class="couple-grid">
      <article class="person person--card reveal">
        <p class="person__role">The Bride</p>
        <h3 class="script script--sm"><%= wedding.bride.name %></h3>
        <p class="person__parents">Daughter of<br><strong><%= wedding.bride.parents %></strong></p>
      </article>

      <div class="amp reveal" aria-hidden="true">&amp;</div>

      <article class="person person--card reveal">
        <p class="person__role">The Groom</p>
        <h3 class="script script--sm"><%= wedding.groom.name %></h3>
        <p class="person__parents">Son of<br><strong><%= wedding.groom.parents %></strong></p>
      </article>
    </div>

    <p class="lead reveal">With the blessings of our elders and the grace of the Almighty, our families joyfully invite you to share in this sacred union.</p>
  </div>
</section>
